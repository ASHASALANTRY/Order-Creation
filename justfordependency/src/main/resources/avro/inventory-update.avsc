{
  "type": "record",
  "name": "InventoryUpdateEvent",
  "namespace": "com.enterprise.inventory.avro",
  "doc": "event triggered when inventory stock levels change.",
  "fields": [
    { "name": "sku", "type": "string", "doc": "stock keeping unit unique product identifier" },
    { "name": "quantityChanged", "type": "int", "doc": "The delta change, can be negative for sales and positive for restocks" }
  ]
}